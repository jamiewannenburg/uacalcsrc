<?xml version="1.0"?>
<algebra>
  <powerAlgebra>
    <cardinality>9</cardinality>
    <power>2</power>
    <root>
      <basicAlgebra>
        <algName>C3</algName>
        <desc>The group of order 3.</desc>
        <cardinality>3</cardinality>
        <operations>
          <op>
            <opSymbol>
              <opName>+</opName>
              <arity>2</arity>
            </opSymbol>
            <opTable>
              <intArray>
                <row r="[0]">0,1,2</row>
                <row r="[1]">1,2,0</row>
                <row r="[2]">2,0,1</row>
              </intArray>
            </opTable>
          </op>
        </operations>
      </basicAlgebra>
    </root>
  </powerAlgebra>
</algebra>
