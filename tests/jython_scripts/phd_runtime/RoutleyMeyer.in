set(ignore_option_dependencies). % GUI handles dependencies

if(Prover9). % Options for Prover9
  assign(max_seconds, 60).
end_if.

if(Mace4).   % Options for Mace4
  assign(max_seconds, 60).
end_if.

formulas(assumptions).

% Routly Meyer semantics
% identity
R(e,x,x).
% commutativity
R(x,y,z)->R(y,x,z).
% associativity
exists x (R(y,z,x)&R(x,v,w)) -> exists x (R(z,v,x)&R(y,x,w)).
% idempotence?
R(x,x,x).
% inversion
R(x,y,z) -> R(z',x,y').
% involution
(x')'=x.
% monotonicity
(R(e,y,x)&R(x,z,w))->R(y,z,w).
% KR
%x'=x.

end_of_list.

formulas(goals).

end_of_list.

