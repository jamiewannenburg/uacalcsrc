%%% Kleene algebra, Kozen (1994)%%%
(x+y)+z = x+(y+z).
x+y = y+x.
x+x = x.
x+0 = x.
(x;y);z = x;(y;z).
x;1 = x.
1;x = x.
x;(y+z) = (x;y) + (x;z).  
(x+y);z = (x;z) + (y;z). 
x;0 = 0.
0;x = 0.
(x <= y) <-> (x+y = y).
%1 + x;x* <= x*.
%1 + x*;x <= x*.
%y + x;z <= z -> x*;y <= z.
%y + z;x <= z -> y;x* <= z. 

%%% Right-residuation %%%

x;y <= z <-> x <= y\z.

%%% Test %%%
