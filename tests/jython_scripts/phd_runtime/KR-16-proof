formulas(assumptions).

%lattice
x^x=x.
x^y=y^x.
x^(y^z)=(x^y)^z.
x v x=x.
x v y=y v x.
x v (y v z)=(x v y) v z.
x ^ (x v y) = x.
x v (x ^ y) = x.

%distributive
x^(y v z) = (x^y)v(x^z).

%leq
(x<=y)<->(x v y=y).

%crl
x*y = y*x.
e*x=x.
x*(y*z)=(x*y)*z.
x<=y\(y*x).
x*(x\y) <= y.
x*(y^z)<= (x*y)^(x*z).
(x\y)^(x\z) = x\(y^z).

% bounds
top = x v ~(x).
bot = x ^ ~(x).
f = ~(e).

%involution1
x = ~(~(x)).
x\y = ~(x*~(y)).
~(x) = x\f.

%square increasing
x<=x*x.

%KR
%e <= (x^~(x))\y.
%x^~(x) <= y.
x <= top.

%simple
(x<=e)->(x=e | x=bot).

%not idempotent
(x != bot & x != top) -> (x*~(x)=f).

%not other el
(x*x=top)->(~(x)*~(x)!=top).

% atom and atom prime is f
(x<=f & x!=bot & x!=f)->(x*(~(x)^f)=f).

end_of_list.

formulas(goals).

%get f from atom
(x!=e & x!=bot & all y((y<=x)->(y=x|y=bot)))->(~((x v e)*(x v e))*(((x v e)*(x v e))^~(x))=f).

